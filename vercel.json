{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/robot.txt",
      "destination": "/api"
    },
    {
      "source": "/e/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth/callback(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|static-loader-data/|.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|webmanifest|txt|xml)$).*)",
      "destination": "/"
    }
  ]
}
