<script>
  // Simple micro-interactions for polish
  const toast = document.getElementById('settings-toast');
  const toastMsg = document.getElementById('toast-message');

  function showToast(text) {
    if (!toast) return;
    toastMsg.textContent = text;
    toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3200);
  }

  // Save Trigger
  document.getElementById('save-settings-btn')?.addEventListener('click', () => {
    showToast('Organiser profile & configurations saved.');
  });

  // Test SMS Dispatcher
  const testBtn = document.getElementById('send-test-sms-btn');
  const feedback = document.getElementById('test-dispatch-feedback');
  testBtn?.addEventListener('click', () => {
    testBtn.disabled = true;
    testBtn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span> Dispatching...';
    setTimeout(() => {
      testBtn.disabled = false;
      testBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">send</span> <span>Send Test SMS</span>';
      if (feedback) feedback.classList.remove('hidden');
      showToast('1 test credit dispatched to +233 24 890 1124');
    }, 1200);
  });

  // Copy Webhook
  document.getElementById('copy-webhook-btn')?.addEventListener('click', () => {
    navigator.clipboard?.writeText('https://api.eventsapp.africa/v1/arkesel-callback');
    showToast('Webhook endpoint copied to clipboard.');
  });

  // Top Up Modal Trigger simulation
  document.getElementById('topup-trigger-btn')?.addEventListener('click', () => {
    showToast('Opening secure Paystack Ghana checkout gateway...');
  });
