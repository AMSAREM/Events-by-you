<script>
  (function initBillingModule() {
    // Current Simulated State
    let currentPlan = 'free'; // 'free' | 'pro'
    let currentSmsCredits = 14;
    let isAnnual = false;

    // Elements
    const liveSmsCount = document.getElementById('live-sms-count');
    const liveEventQuota = document.getElementById('live-event-quota');
    const liveEventBar = document.getElementById('live-event-bar');
    const liveAttendeeCap = document.getElementById('live-attendee-cap');
    const activePlanPill = document.getElementById('active-plan-pill');
    const upgradeProBtn = document.getElementById('upgrade-pro-btn');
    const resetStateBtn = document.getElementById('reset-state-btn');
    const quickTestCreditsBtn = document.getElementById('quick-test-credits-btn');

    const toggleMonthly = document.getElementById('toggle-monthly');
    const toggleAnnual = document.getElementById('toggle-annual');
    const proPriceVal = document.getElementById('pro-price-val');
    const proPricePeriod = document.getElementById('pro-price-period');
    const proPriceNote = document.getElementById('pro-price-note');

    const customSlider = document.getElementById('custom-slider');
    const sliderCreditsLabel = document.getElementById('slider-credits-label');
    const customCalcPrice = document.getElementById('custom-calc-price');
    const customTopupBtn = document.getElementById('custom-topup-btn');

    const toast = document.getElementById('toast-notification');
    const toastMsg = document.getElementById('toast-message');
    const toastIcon = document.getElementById('toast-icon');

    function showToast(message, iconName = 'check_circle') {
      if (!toast) return;
      toastMsg.textContent = message;
      toastIcon.textContent = iconName;
      toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3500);
    }

    function updateStateUI() {
      // SMS display
      liveSmsCount.textContent = currentSmsCredits.toLocaleString();
      
      // Pro Plan UI adjustments
      if (currentPlan === 'pro') {
        activePlanPill.textContent = 'PRO TIER ACTIVE';
        activePlanPill.className = 'px-space-sm py-0.5 rounded-full bg-brand-black text-canvas font-label-md text-label-md uppercase tracking-wider';
        liveEventQuota.textContent = '∞';
        liveEventBar.style.width = '15%';
        liveAttendeeCap.textContent = '∞';
        upgradeProBtn.disabled = true;
        upgradeProBtn.innerHTML = `<span>Pro Tier Active</span><span class="material-symbols-outlined text-[16px]">verified</span>`;
        upgradeProBtn.className = 'w-full py-space-sm px-space-md rounded-full bg-surface text-text-muted font-label-md text-label-md text-center cursor-not-allowed flex items-center justify-center gap-space-xs';
      } else {
        activePlanPill.textContent = 'Free Plan';
        activePlanPill.className = 'px-space-sm py-0.5 rounded-full bg-surface-container-high text-brand-black font-label-md text-label-md uppercase tracking-wider';
        liveEventQuota.textContent = '1/1';
        liveEventBar.style.width = '100%';
        liveAttendeeCap.textContent = '48';
        upgradeProBtn.disabled = false;
        upgradeProBtn.innerHTML = `<span>Upgrade to Pro Tier</span><span class="material-symbols-outlined text-[16px]">arrow_forward</span>`;
        upgradeProBtn.className = 'w-full py-space-sm px-space-md rounded-full bg-brand-black hover:bg-primary-container text-canvas font-label-md text-label-md text-center transition-all shadow-md flex items-center justify-center gap-space-xs';
      }
    }

    // Handlers
    window.topUpCredits = function(amount, packName) {
      currentSmsCredits += amount;
      updateStateUI();
      showToast(`+${amount.toLocaleString()} SMS added via ${packName}!`);
    };

    if (upgradeProBtn) {
      upgradeProBtn.addEventListener('click', () => {
        if (currentPlan === 'pro') return;
        currentPlan = 'pro';
        currentSmsCredits += 500; // Monthly free grant bonus
        updateStateUI();
        showToast('Successfully upgraded to Pro Tier! +500 SMS granted.', 'stars');
      });
    }

    if (resetStateBtn) {
      resetStateBtn.addEventListener('click', () => {
        currentPlan = 'free';
        currentSmsCredits = 14;
        updateStateUI();
        showToast('Account reverted to Free Tier sandbox state.', 'refresh');
      });
    }

    if (quickTestCreditsBtn) {
      quickTestCreditsBtn.addEventListener('click', () => {
        window.topUpCredits(100, 'Test Credits Simulator');
      });
    }

    // Toggle Monthly / Annual Pricing
    if (toggleMonthly && toggleAnnual) {
      toggleMonthly.addEventListener('click', () => {
        isAnnual = false;
        toggleMonthly.className = 'px-space-md py-space-xs rounded-full font-label-md text-label-md bg-surface-elevated text-brand-black shadow-sm transition-all';
        toggleAnnual.className = 'px-space-md py-space-xs rounded-full font-label-md text-label-md text-text-muted hover:text-brand-black transition-all flex items-center gap-1';
        proPriceVal.textContent = '$29';
        proPricePeriod.textContent = '/ month';
        proPriceNote.textContent = 'Billed monthly • Cancel anytime with zero downtime';
      });

      toggleAnnual.addEventListener('click', () => {
        isAnnual = true;
        toggleAnnual.className = 'px-space-md py-space-xs rounded-full font-label-md text-label-md bg-surface-elevated text-brand-black shadow-sm transition-all flex items-center gap-1';
        toggleMonthly.className = 'px-space-md py-space-xs rounded-full font-label-md text-label-md text-text-muted hover:text-brand-black transition-all';
        proPriceVal.textContent = '$290';
        proPricePeriod.textContent = '/ year';
        proPriceNote.textContent = 'Includes 2 months free • Save $58 annually';
      });
    }

    // Custom Calculator Slider Handler
    function updateCalculator() {
      if (!customSlider) return;
      const count = parseInt(customSlider.value, 10);
      sliderCreditsLabel.textContent = `${count.toLocaleString()} SMS Credits`;
      
      // Tiered bulk rate calculation:
      // Base: 0.20, >= 1000: 0.175, >= 5000: 0.15
      let rate = 0.20;
      if (count >= 5000) {
        rate = 0.15;
      } else if (count >= 1000) {
        rate = 0.175;
      }
      const totalGHS = Math.round(count * rate);
      customCalcPrice.textContent = `GH₵ ${totalGHS.toLocaleString()}`;
    }

    if (customSlider) {
      customSlider.addEventListener('input', updateCalculator);
      updateCalculator();
    }

    if (customTopupBtn && customSlider) {
      customTopupBtn.addEventListener('click', () => {
        const count = parseInt(customSlider.value, 10);
        window.topUpCredits(count, 'Custom Bundle');
      });
    }

    // Initial sync
    updateStateUI();
  })();
</script></main></div><nav class="md:hidden fixed bottom-margin-mobile left-margin-mobile right-margin-mobile z-50 bg-brand-black/95 backdrop-blur-lg rounded-full py-space-xs px-space-md flex items-center justify-around shadow-[0_12px_32px_-8px_rgba(11,11,11,0.2)]" data-active-classes="text-on-primary"><a class="p-space-sm text-secondary-fixed-dim hover:text-on-primary" data-path="overview" href="#"><span class="material-symbols-outlined text-[22px]">dashboard</span></a><a class="p-space-sm text-secondary-fixed-dim hover:text-on-primary" data-path="events" href="#"><span class="material-symbols-outlined text-[22px]">calendar_today</span></a><a class="p-space-sm text-secondary-fixed-dim hover:text-on-primary" data-path="messages" href="#"><span class="material-symbols-outlined text-[22px]">chat_bubble</span></a><a class="p-space-sm text-secondary-fixed-dim hover:text-on-primary" data-path="upgrade-and-credits" href="#"><span class="material-symbols-outlined text-[22px]">credit_card</span></a><a class="p-space-sm text-secondary-fixed-dim hover:text-on-primary" data-path="settings" href="#"><span class="material-symbols-outlined text-[22px]">settings</span></a></nav></body></html>