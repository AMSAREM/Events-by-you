<div class="fixed bottom-6 right-6 md:right-10 z-50 transform translate-y-32 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-space-sm px-space-md py-space-sm rounded-full bg-brand-black text-canvas shadow-xl" id="toast-notification">
