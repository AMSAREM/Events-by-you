<!-- Interactive Micro-interactions & Real-time Live Simulator -->
<script>
// Live counter simulation
(function initLiveCounters() {
  const regEl = document.getElementById('registered-counter');
  const smsEl = document.getElementById('sms-counter');
  if (!regEl || !smsEl) return;

  let regCount = 420;
  let smsCount = 418;

  setInterval(() => {
    // 35% chance to increment to simulate live gate activity
    if (Math.random() < 0.35) {
      regCount += 1;
      smsCount += 1;
      regEl.innerText = regCount;
      smsEl.innerText = smsCount;
      
      // highlight flash
      regEl.classList.add('text-emerald-600');
      smsEl.classList.add('text-emerald-600');
      setTimeout(() => {
        regEl.classList.remove('text-emerald-600');
        smsEl.classList.remove('text-emerald-600');
      }, 700);
    }
  }, 4500);
})();

// Billing Switcher
function setBilling(mode) {
  const btnMonthly = document.getElementById('btn-billing-monthly');
  const btnAnnual = document.getElementById('btn-billing-annual');
  const priceTag = document.getElementById('pro-price-tag');
  const subTag = document.getElementById('pro-sub-tag');

  if (mode === 'annual') {
    btnAnnual.className = 'px-4 py-1.5 rounded-full font-label-md text-label-md bg-white text-brand-black shadow-xs transition-all';
    btnMonthly.className = 'px-4 py-1.5 rounded-full font-label-md text-label-md text-text-muted hover:text-brand-black transition-all';
    if (priceTag) priceTag.innerText = '$15';
    if (subTag) subTag.innerText = '/ month (billed $180/yr) • approx. GHS 230/mo';
  } else {
    btnMonthly.className = 'px-4 py-1.5 rounded-full font-label-md text-label-md bg-white text-brand-black shadow-xs transition-all';
    btnAnnual.className = 'px-4 py-1.5 rounded-full font-label-md text-label-md text-text-muted hover:text-brand-black transition-all';
    if (priceTag) priceTag.innerText = '$19';
    if (subTag) subTag.innerText = '/ month • approx. GHS 290';
  }
}

// CTA Form confirmation feedback
function handleFormSubmit() {
  const input = document.getElementById('organizer-email-input');
  if (!input) return;
  const val = input.value;
  if (val) {
    const btn = document.querySelector('#signup-form button');
    const prevContent = btn.innerHTML;
    btn.innerHTML = '<span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-emerald-400">check</span> Link Sent!</span>';
    input.value = '';
    input.placeholder = 'Magic invite link sent to inbox!';
    setTimeout(() => {
      btn.innerHTML = prevContent;
      input.placeholder = 'Enter your organizer email';
    }, 4000);
  }
}
</script>


<script>
let currentSlideIndex = 0;
const totalSlides = 3;
let sliderInterval = null;
let isSliderPaused = false;

function updateSlideUI() {
  for (let i = 0; i < totalSlides; i++) {
    const slideEl = document.getElementById(i === 2 ? 'slide-3' : 'slide-' + i);
    const tabBtn = document.getElementById('tab-btn-' + i);
    if (slideEl && tabBtn) {
      if (i === currentSlideIndex) {
        slideEl.classList.remove('hidden');
        slideEl.classList.add('block');
        tabBtn.className = 'px-4 py-2 rounded-full font-label-md text-label-md bg-brand-black text-white shadow-sm transition-all flex items-center gap-2';
        const pillNum = tabBtn.querySelector('span');
        if (pillNum) pillNum.className = 'w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-[11px] font-bold text-white';
      } else {
        slideEl.classList.remove('block');
        slideEl.classList.add('hidden');
        tabBtn.className = 'px-4 py-2 rounded-full font-label-md text-label-md text-text-muted hover:text-brand-black transition-all flex items-center gap-2';
        const pillNum = tabBtn.querySelector('span');
        if (pillNum) pillNum.className = 'w-5 h-5 rounded-full bg-surface-container flex items-center justify-center text-[11px] font-bold text-text-muted';
      }
    }
  }

  const progress = document.getElementById('slider-progress-bar');
  const counter = document.getElementById('slide-counter-indicator');
  if (progress) {
    const pct = ((currentSlideIndex + 1) / totalSlides) * 100;
    progress.style.width = pct + '%';
  }
  if (counter) {
    counter.innerText = '0' + (currentSlideIndex + 1) + ' / 03';
  }
}

function goToSlide(index) {
  currentSlideIndex = index;
  updateSlideUI();
}

function nextSlide() {
  currentSlideIndex = (currentSlideIndex + 1) % totalSlides;
  updateSlideUI();
}

function prevSlide() {
  currentSlideIndex = (currentSlideIndex - 1 + totalSlides) % totalSlides;
  updateSlideUI();
}

function pauseSlider() {
  isSliderPaused = true;
}

function resumeSlider() {
  isSliderPaused = false;
}

function startAutoSlider() {
  if (sliderInterval) clearInterval(sliderInterval);
  sliderInterval = setInterval(() => {
    if (!isSliderPaused) {
      nextSlide();
    }
  }, 5500);
}

startAutoSlider();
</script>



