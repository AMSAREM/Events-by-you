    const eyeIcon = document.getElementById('eyeIcon');
    const strengthText = document.getElementById('strengthText');
    const m1 = document.getElementById('meter1');
    const m2 = document.getElementById('meter2');
    const m3 = document.getElementById('meter3');
    const m4 = document.getElementById('meter4');

    if (togglePassword && passwordInput) {
      togglePassword.addEventListener('click', () => {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
      });
    }

    if (passwordInput) {
      passwordInput.addEventListener('input', (e) => {
        const val = e.target.value;
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        // Reset meters
        [m1, m2, m3, m4].forEach(m => {
          m.className = 'h-1 rounded-full bg-border-subtle transition-colors duration-300';
        });

        if (val.length === 0) {
          strengthText.textContent = 'Min 8 chars, 1 uppercase, 1 number';
          strengthText.className = 'font-caption text-caption text-text-muted';
          return;
        }

        if (score === 1) {
          m1.classList.remove('bg-border-subtle');
          m1.classList.add('bg-accent-alert');
          strengthText.textContent = 'Weak password';
          strengthText.className = 'font-caption text-caption text-accent-alert font-medium';
        } else if (score === 2) {
          [m1, m2].forEach(m => {
            m.classList.remove('bg-border-subtle');
            m.classList.add('bg-amber-500');
          });
          strengthText.textContent = 'Moderate';
          strengthText.className = 'font-caption text-caption text-amber-500 font-medium';
        } else if (score === 3) {
          [m1, m2, m3].forEach(m => {
            m.classList.remove('bg-border-subtle');
            m.classList.add('bg-brand-black');
          });
          strengthText.textContent = 'Good';
          strengthText.className = 'font-caption text-caption text-on-surface font-medium';
        } else if (score >= 4) {
          [m1, m2, m3, m4].forEach(m => {
            m.classList.remove('bg-border-subtle');
            m.classList.add('bg-emerald-600');
          });
          strengthText.textContent = 'Strong (Excellent for RLS workspace)';
          strengthText.className = 'font-caption text-caption text-emerald-600 font-semibold';
        }
      });
    }
  })();
</script></main><footer class="w-full bg-surface py-6"><div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-space-sm"><span class="font-caption text-caption text-text-muted">© 2025 Events App Inc. All rights reserved.</span><div class="flex items-center gap-space-lg"><a class="font-caption text-caption text-text-muted hover:text-on-surface transition-colors" data-path="privacy-policy" href="#">Privacy Policy</a><a class="font-caption text-caption text-text-muted hover:text-on-surface transition-colors" data-path="terms-of-service" href="#">Terms of Service</a><a class="font-caption text-caption text-text-muted hover:text-on-surface transition-colors" data-path="help-documentation" href="#">Support</a></div></div></footer></body></html>